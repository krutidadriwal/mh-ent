# Supabase project URL. Supabase dashboard -> Project Settings -> API.
# Also used to verify DSO access tokens against the project's published JWKS
# (.../auth/v1/.well-known/jwks.json) -- no separate JWT secret needed.
SUPABASE_URL=

# Service role key -- server only. Bypasses RLS, which is how the server
# reads/writes every table (RLS is on with no policies, so nothing else can).
# Never put this in the Android app.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Supabase sends on every call to /api/supabase/*.
# Generate once with: openssl rand -base64 48
# Then in Supabase dashboard -> Database -> Webhooks -> (webhook) -> HTTP
# Headers, add:  x-webhook-secret: <this value>
SUPABASE_WEBHOOK_SECRET=
